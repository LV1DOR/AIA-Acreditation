# No secret values. Fill every blank before preflight; keep this file private by policy.
AIA_PROJECT_NAME=aia-accreditation-production
AIA_WEB_IMAGE=
AIA_WORKER_IMAGE=
AIA_TOOLS_IMAGE=
# Reviewed supported image, pinned by registry digest. Legacy community image is forbidden in production.
AIA_MINIO_IMAGE=
AIA_TLS_DIRECTORY=/etc/aia-accreditation/tls
AIA_SECRETS_DIRECTORY=/etc/aia-accreditation/secrets
AIA_BACKUP_DIRECTORY=/var/lib/aia-accreditation/backups
AIA_HTTP_BIND_PORT=18880
AIA_HTTPS_BIND_PORT=18443
