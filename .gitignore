# impeccable-ignore-start
# Ephemeral output, runtime state, and per-developer overrides.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end

# Local Phase 3 candidate/rehearsal artifacts.
apps/worker/.candidate-*/
.impeccable/releases/
infra/linux-test/runtime.mjs

# VPS source kit: generated caches and private operator state never belong in Git.
**/__pycache__/
**/*.py[cod]
infra/vps-staging/state/
infra/vps-staging/secrets/
infra/vps-staging/tls/
infra/vps-staging/licenses/
infra/vps-staging/logs/
infra/vps-staging/backups/
infra/vps-staging/releases/
infra/vps-staging/*.license
infra/vps-staging/*.key
infra/vps-staging/*.pem

# Production operator code is tracked; all generated/private material stays local.
infra/vps-production/state/
infra/vps-production/incoming/
infra/vps-production/secrets/
infra/vps-production/tls/
infra/vps-production/licenses/
infra/vps-production/logs/
infra/vps-production/backups/
infra/vps-production/**/*.tar
infra/vps-production/**/*.tar.gz
infra/vps-production/**/*.license
infra/vps-production/**/*.key
infra/vps-production/**/*.pem
