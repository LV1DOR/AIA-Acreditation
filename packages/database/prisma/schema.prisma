generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum InternalOrganisation {
  AIA
  PARKALGAR
}

enum UserRole {
  ADMIN
  COMPANY_LEADER
}

enum EventStatus {
  DRAFT
  ONBOARDING_OPEN
  ONBOARDING_CLOSED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CompanyRegistrationStatus {
  DRAFT
  AIA_REVIEW
  RETURNED_FOR_CORRECTION
  REJECTED
  APPROVED
}

enum ReviewReasonCategory {
  ZONES
  VEHICLE_PASS
  PERSONNEL
  PHOTO
  DOCUMENT
  WORK_DAYS
  HEADCOUNT
  DUPLICATE
  OTHER
}

enum SubmissionReviewOutcome {
  APPROVED
  RETURNED_FOR_CORRECTION
  REJECTED
  APPROVAL_INVALIDATED
}

enum SubmissionParticipantReviewOutcome {
  APPROVED
  RETURNED_FOR_CORRECTION
}

enum AuditActorType {
  ADMIN
  COMPANY_LEADER
  EMPLOYEE_LINK
  SYSTEM
}

enum DocumentType {
  PASSPORT
  CARTAO_CIDADAO
  CARTAO_RESIDENCIA
}

enum ParticipantStatus {
  DRAFT
  AWAITING_EMPLOYEE
  AWAITING_LEADER_REVIEW
  LEADER_APPROVED
  DUPLICATE_REVIEW_REQUIRED
  REMOVED
  REPLACED
}

enum RequestType {
  EXTRA_PERSONNEL
  ADD_AFTER_DEADLINE
  REMOVE_AFTER_DEADLINE
  REPLACE_PERSON
  EDIT_PERSON
  CHANGE_WORK_DAYS
  REPLACE_PHOTO
  VEHICLE_PASS_CHANGE
  ZONE_CHANGE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestPriority {
  NORMAL
  URGENT
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique
  role        UserRole
  disabledAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  memberships CompanyLeaderMembership[]
  audits      AuditEvent[]
  notifications Notification[]
  vehicleDecisions VehiclePassRequest[]
  createdInvitations LeaderInvitation[] @relation("InvitationCreator")
  acceptedInvitations LeaderInvitation[] @relation("InvitationAcceptor")
  sessions AuthSession[]
  createdEmployeeTokens EmployeeInvitationToken[]
  submittedCompanySubmissions CompanySubmission[] @relation("SubmissionSubmitter")
  submissionReviews CompanySubmissionReview[] @relation("SubmissionReviewer")
  submissionParticipantReviews SubmissionParticipantReview[] @relation("SubmissionParticipantReviewer")
  submissionPhotoAdjustments SubmissionPhotoAdjustment[] @relation("SubmissionPhotoAdjuster")
  createdRequests CompanyRequest[] @relation("RequestCreator")
  reviewedRequests CompanyRequest[] @relation("RequestReviewer")
}

model Company {
  id            String @id @default(uuid()) @db.Uuid
  name          String
  internalOrganisation InternalOrganisation? @unique
  deactivatedAt DateTime? @db.Timestamptz(3)
  version       Int @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  memberships   CompanyLeaderMembership[]
  registrations CompanyEventRegistration[]
}

model CompanyLeaderMembership {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  userId    String @db.Uuid
  revokedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  registrations CompanyEventRegistration[]
  @@unique([companyId, userId])
  @@unique([id, companyId])
  @@index([userId, revokedAt])
}

model Event {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String? @unique
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  onboardingOpensAt DateTime @db.Timestamptz(3)
  onboardingClosesAt DateTime @db.Timestamptz(3)
  timezone String @default("Europe/Lisbon")
  status EventStatus @default(DRAFT)
  bannerObjectKey String?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  zones EventZone[]
  registrations CompanyEventRegistration[]
  participants EventParticipant[]
  @@index([status, onboardingClosesAt])
}

model Zone {
  id String @id @default(uuid()) @db.Uuid
  name String
  sortOrder Int @default(0)
  deactivatedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events EventZone[]
  @@index([deactivatedAt, sortOrder])
}

model EventZone {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  zoneId String @db.Uuid
  deactivatedAt DateTime? @db.Timestamptz(3)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  requests CompanyZoneRequest[]
  participantRequests ParticipantZoneRequest[]
  @@unique([eventId, zoneId])
}

model JobRole {
  id String @id @default(uuid()) @db.Uuid
  name String
  sortOrder Int @default(0)
  deactivatedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  participants EventParticipant[]
  @@index([deactivatedAt, sortOrder])
}

model CompanyEventRegistration {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  companyId String @db.Uuid
  primaryLeaderMembershipId String? @db.Uuid
  withdrawnAt DateTime? @db.Timestamptz(3)
  status CompanyRegistrationStatus @default(DRAFT)
  personnelLimit Int @default(10)
  erasedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryLeader CompanyLeaderMembership? @relation(fields: [primaryLeaderMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  zones CompanyZoneRequest[]
  vehiclePass VehiclePassRequest?
  @@unique([eventId, companyId])
  @@unique([id, eventId])
  @@unique([id, companyId])
  @@index([eventId, status])
  @@index([primaryLeaderMembershipId, companyId])
  invitations LeaderInvitation[]
  participants EventParticipant[]
  submissions CompanySubmission[]
  requests CompanyRequest[]
  importBatches InternalImportBatch[]
}

model CompanySubmission {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  version Int
  registrationVersion Int
  snapshot Json
  contentHash String @db.Char(64)
  submittedByUserId String @db.Uuid
  submittedAt DateTime @default(now()) @db.Timestamptz(3)
  registration CompanyEventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  submittedBy User @relation("SubmissionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviews CompanySubmissionReview[]
  participantReviews SubmissionParticipantReview[]
  photoAdjustments SubmissionPhotoAdjustment[]
  fulfilledRequests CompanyRequest[] @relation("RequestFulfillment")
  @@unique([registrationId, version])
  @@index([registrationId, submittedAt])
}

model CompanySubmissionReview {
  id String @id @default(uuid()) @db.Uuid
  submissionId String @db.Uuid
  outcome SubmissionReviewOutcome
  reasonCategory ReviewReasonCategory?
  comment String?
  reviewedByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  submission CompanySubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewedBy User @relation("SubmissionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  @@index([submissionId, createdAt])
}

model SubmissionParticipantReview {
  id String @id @default(uuid()) @db.Uuid
  submissionId String @db.Uuid
  participantId String @db.Uuid
  outcome SubmissionParticipantReviewOutcome
  reasonCategory ReviewReasonCategory?
  comment String?
  reviewedByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  submission CompanySubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  reviewedBy User @relation("SubmissionParticipantReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  @@unique([submissionId, participantId])
  @@index([participantId, outcome])
}

model SubmissionPhotoAdjustment {
  id String @id @default(uuid()) @db.Uuid
  submissionId String @db.Uuid
  participantId String @db.Uuid
  photoObjectKey String
  adjustedByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  submission CompanySubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  adjustedBy User @relation("SubmissionPhotoAdjuster", fields: [adjustedByUserId], references: [id], onDelete: Restrict)
  @@index([submissionId, participantId, createdAt])
}

model EventParticipant {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  eventId String @db.Uuid
  jobRoleId String? @db.Uuid
  status ParticipantStatus @default(DRAFT)
  fullName String?
  dateOfBirth DateTime? @db.Date
  documentType DocumentType?
  documentNumberCiphertext String?
  documentNumberIv String?
  documentNumberAuthTag String?
  documentNumberKeyVersion Int?
  documentNumberFingerprint String? @db.Char(64)
  documentNumberLast3 String? @db.VarChar(3)
  documentExpiryDate DateTime? @db.Date
  mobileE164 String?
  nationalityCode String? @db.Char(2)
  photoObjectKey String?
  privacyNoticeVersion String?
  privacyAcknowledgedAt DateTime? @db.Timestamptz(3)
  erasedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  registration CompanyEventRegistration @relation(fields: [registrationId, eventId], references: [id, eventId], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  jobRole JobRole? @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  workDays ParticipantWorkDay[]
  employeeTokens EmployeeInvitationToken[]
  submissionPhotoAdjustments SubmissionPhotoAdjustment[]
  submissionReviews SubmissionParticipantReview[]
  requests CompanyRequest[]
  internalReference String? @db.VarChar(100)
  photoReference String? @db.VarChar(200)
  individualZones ParticipantZoneRequest[]
  editRequestId String? @db.Uuid
  editRequest CompanyRequest? @relation("ParticipantEditGrant", fields: [editRequestId, registrationId], references: [id, registrationId], onDelete: Restrict)
  replacementRequestId String? @unique @db.Uuid
  replacementRequest CompanyRequest? @relation("ReplacementParticipant", fields: [replacementRequestId], references: [id], onDelete: Restrict)
  @@unique([id, eventId])
  @@unique([registrationId, internalReference])
  @@index([registrationId, status])
  @@index([eventId, documentNumberFingerprint])
  @@index([jobRoleId])
}

model CompanyRequest {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  targetParticipantId String? @db.Uuid
  createdByUserId String @db.Uuid
  type RequestType
  priority RequestPriority @default(NORMAL)
  reason String
  payload Json
  status RequestStatus @default(PENDING)
  resolutionComment String?
  reviewedByUserId String? @db.Uuid
  reviewedAt DateTime? @db.Timestamptz(3)
  fulfilledBySubmissionId String? @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  registration CompanyEventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  targetParticipant EventParticipant? @relation(fields: [targetParticipantId], references: [id], onDelete: Restrict)
  createdBy User @relation("RequestCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("RequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  editableParticipants EventParticipant[] @relation("ParticipantEditGrant")
  effectBaseVersion Int?
  effectBasePhotoKey String?
  replacementParticipant EventParticipant? @relation("ReplacementParticipant")
  fulfilledBySubmission CompanySubmission? @relation("RequestFulfillment", fields: [fulfilledBySubmissionId], references: [id], onDelete: Restrict)
  @@unique([id, registrationId])
  @@index([status, priority, createdAt])
  @@index([registrationId, createdAt])
  @@index([targetParticipantId, status])
  @@index([fulfilledBySubmissionId])
}

model ParticipantWorkDay {
  id String @id @default(uuid()) @db.Uuid
  participantId String @db.Uuid
  workDate DateTime @db.Date
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  @@unique([participantId, workDate])
}

// No personnel FK: cleanup remains possible if a draft is deleted before adoption.
model PhotoUpload {
  id String @id @default(uuid()) @db.Uuid
  objectKey String @unique
  bucket String
  participantId String @db.Uuid
  participantVersion Int
  submissionId String? @db.Uuid
  status String @default("STAGED")
  expiresAt DateTime @db.Timestamptz(3)
  attempts Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([status, expiresAt])
}

model EmployeeInvitationToken {
  id String @id @default(uuid()) @db.Uuid
  participantId String @db.Uuid
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  @@index([participantId, createdAt])
}

model LeaderInvitation {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  companyId String @db.Uuid
  emailNormalized String
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String @db.Uuid
  acceptedByUserId String? @db.Uuid
  registration CompanyEventRegistration @relation(fields: [registrationId, companyId], references: [id, companyId], onDelete: Restrict)
  creator User @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptor User? @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  @@index([registrationId, createdAt])
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  fingerprint String @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model CompanyZoneRequest {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  eventId String @db.Uuid
  zoneId String @db.Uuid
  registration CompanyEventRegistration @relation(fields: [registrationId, eventId], references: [id, eventId], onDelete: Restrict)
  eventZone EventZone @relation(fields: [eventId, zoneId], references: [eventId, zoneId], onDelete: Restrict)
  @@unique([registrationId, zoneId])
  @@index([eventId, zoneId])
}

model VehiclePassRequest {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @unique @db.Uuid
  required Boolean @default(false)
  requestedQuantity Int @default(0)
  justification String?
  requestedAt DateTime? @db.Timestamptz(3)
  approvedQuantity Int?
  decisionComment String?
  decidedByUserId String? @db.Uuid
  decidedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  registration CompanyEventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  decidedBy User? @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  actorType AuditActorType
  actorUserId String? @db.Uuid
  action String
  entityType String
  entityId String @db.Uuid
  eventId String? @db.Uuid
  companyId String? @db.Uuid
  correlationId String @db.Uuid
  metadataVersion Int @default(1)
  metadata Json
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([eventId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
}

model OutboxMessage {
  id String @id @default(uuid()) @db.Uuid
  deduplicationKey String @unique
  type String
  payloadVersion Int @default(1)
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  attempts Int @default(0)
  leaseOwner String? @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  lastFailureCode String?
  registrationId String? @db.Uuid
  eventId String? @db.Uuid
  recoveryPayload Json?
  terminalAt DateTime? @db.Timestamptz(3)
  recoveries Int @default(0)
  emailDelivery EmailDelivery?
}

model EmailDelivery {
  id String @id @default(uuid()) @db.Uuid
  outboxMessageId String? @unique @db.Uuid
  recipientHash String? @db.Char(64)
  provider String?
  providerMessageId String?
  status String @default("QUEUED")
  attempts Int @default(0)
  lastFailureCode String?
  sentAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  outboxMessage OutboxMessage? @relation(fields: [outboxMessageId], references: [id], onDelete: Restrict)
  // Sending/queue state above is independent of provider delivery observations.
  recipients String[] @default([])
  subject String? @db.VarChar(998)
  sender String? @db.VarChar(320)
  senderDomain String? @db.VarChar(253)
  category String? @db.VarChar(100)
  companyId String? @db.Uuid
  eventId String? @db.Uuid
  resendEmailId String? @unique @db.Uuid
  resendIdHash String? @unique @db.Char(64)
  rfcMessageId String? @db.VarChar(500)
  rfcIdHash String? @db.Char(64)
  providerStatus String? @db.VarChar(30)
  providerStatusAt DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  lastWebhookAt DateTime? @db.Timestamptz(3)
  reconciledAt DateTime? @db.Timestamptz(3)
  reconciledStatus String? @db.VarChar(30)
  erasedAt DateTime? @db.Timestamptz(3)
  events EmailDeliveryEvent[]
  providerIdentities EmailProviderIdentity[]
  @@index([status, createdAt])
  @@index([providerStatus, createdAt, id])
  @@index([createdAt, id])
  @@index([rfcIdHash])
  @@index([recipientHash])
  @@index([recipients], type: Gin)
  @@index([eventId, createdAt, id])
  @@index([senderDomain, createdAt, id])
  @@index([companyId, eventId])
}

model EmailDeliveryEvent {
  id String @id @default(uuid()) @db.Uuid
  emailDeliveryId String @db.Uuid
  svixId String @unique @db.VarChar(200)
  payloadDigest String @db.Char(64)
  type String @db.VarChar(40)
  occurredAt DateTime @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  reasonCode String? @db.VarChar(100)
  providerMessage String? @db.VarChar(4000)
  smtpResponse String? @db.VarChar(8000)
  resendEmailId String? @db.Uuid
  message EmailDelivery @relation(fields: [emailDeliveryId], references: [id], onDelete: Restrict)
  @@index([emailDeliveryId, occurredAt, id])
}

model EmailProviderIdentity {
  idHash String @id @db.Char(64)
  resendEmailId String? @unique @db.Uuid
  emailDeliveryId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  reconciledAt DateTime? @db.Timestamptz(3)
  reconciledStatus String? @db.VarChar(30)
  message EmailDelivery @relation(fields: [emailDeliveryId], references: [id], onDelete: Restrict)
  @@index([emailDeliveryId])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  recipientUserId String @db.Uuid
  eventId String? @db.Uuid
  registrationId String? @db.Uuid
  type String
  parameters Json
  deduplicationKey String @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)
  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  @@index([recipientUserId, readAt, createdAt])
}

model ParticipantZoneRequest {
  id String @id @default(uuid()) @db.Uuid
  participantId String @db.Uuid
  eventId String @db.Uuid
  zoneId String @db.Uuid
  participant EventParticipant @relation(fields: [participantId, eventId], references: [id, eventId], onDelete: Restrict)
  eventZone EventZone @relation(fields: [eventId, zoneId], references: [eventId, zoneId], onDelete: Restrict)
  @@unique([participantId, zoneId])
  @@index([eventId, zoneId])
}

model InternalImportBatch {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  fileHash String @db.Char(64)
  createdByUserId String @db.Uuid
  createdCount Int
  skippedCount Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  registration CompanyEventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  @@unique([registrationId, fileHash])
}

// Append-only approved text; event IDs are checked in the domain and SQL migration.
model PrivacyNotice {
  synthetic Boolean @default(true)
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  kind String
  version String @db.VarChar(100)
  textPt String
  textEn String
  contentHash String @db.Char(64)
  approvalReference String
  approvedByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([eventId, kind, version])
  @@index([eventId, kind, createdAt])
}

model PrivacyAcknowledgement {
  id String @id @default(uuid()) @db.Uuid
  noticeId String? @db.Uuid
  eventId String @db.Uuid
  registrationId String @db.Uuid
  participantId String? @db.Uuid
  submissionId String? @db.Uuid
  actorType String
  actorUserId String? @db.Uuid
  locale String
  noticeVersion String
  noticeHash String @db.Char(64)
  presentedText String
  acknowledgedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([registrationId, acknowledgedAt])
  @@index([participantId])
}

model EventRetentionPolicy {
  synthetic Boolean @default(true)
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  recordsEraseAfter DateTime @db.Timestamptz(3)
  evidenceEraseAfter DateTime @db.Timestamptz(3)
  communicationsEraseAfter DateTime @db.Timestamptz(3)
  backupsEraseAfter DateTime @db.Timestamptz(3)
  approvalReference String
  approvedByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([eventId, createdAt])
}

model EventPrivacyHold {
  eventId String @id @db.Uuid
  active Boolean
  reference String
  updatedByUserId String @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model PrivacyErasureJob {
  synthetic Boolean @default(true)
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  eventId String @db.Uuid
  policyId String @db.Uuid
  stage String @default("PERSONAL_DATA")
  status String @default("QUEUED")
  requestedByUserId String @db.Uuid
  authorisationReference String
  registrationVersion Int
  previewHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  databaseErasedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  evidencePurgeRequestedAt DateTime? @db.Timestamptz(3)
  evidencePurgeRequestedByUserId String? @db.Uuid
  evidencePurgeReference String?
  externalCopiesReference String?
  externalCopiesVerifiedByUserId String? @db.Uuid
  lastFailureCode String?
  attempts Int @default(0)
  objects StorageDeletion[]
  @@index([status, createdAt])
}

model StorageDeletion {
  id String @id @default(uuid()) @db.Uuid
  jobId String? @db.Uuid
  bucket String
  objectKey String
  eventId String? @db.Uuid
  policyId String? @db.Uuid
  authorisationReference String?
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseOwner String? @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  lastFailureCode String?
  verifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  job PrivacyErasureJob? @relation(fields:[jobId],references:[id],onDelete:Restrict)
  @@unique([bucket, objectKey])
  @@index([status, availableAt])
}

model BackupRun {
  id String @id @default(uuid()) @db.Uuid
  status String
  destination String
  archiveHash String? @db.Char(64)
  migrationHash String? @db.Char(64)
  keyBundleHash String? @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  verifiedAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  lastFailureCode String?
  @@index([status, createdAt])
}

model OperationalHeartbeat {
  id String @id
  lastSeenAt DateTime @db.Timestamptz(3)
  errorCount Int @default(0)
  lastErrorCode String?
}
