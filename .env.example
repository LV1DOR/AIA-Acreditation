# Local development only. Never reuse these credentials outside the isolated local stack.
DATABASE_URL=postgresql://acreditacao_local:local_only_password@127.0.0.1:16432/aia_acreditacao_local
TEST_DATABASE_URL=postgresql://acreditacao_local:local_only_password@127.0.0.1:16432/aia_acreditacao_test
REDIS_URL=redis://127.0.0.1:16379
WORKER_HEALTH_PORT=3102
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_FROM=acreditacao@example.invalid
# SMTP_USER=
# SMTP_PASSWORD=
# Resend is the future provider after domain purchase/verification; not Postmark.
APP_ORIGIN=http://127.0.0.1:3100
# Add all four to enable Clerk. Keep the secret key and encryption key server-only.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=
# AUTH_EMAIL_ENCRYPTION_KEY=
# Generate AUTH_EMAIL_ENCRYPTION_KEY as 32 cryptographically random bytes encoded as hex.
# Configure Clerk invite-only access and SMTP webhook delivery; see docs/AUTH-SETUP.md.
