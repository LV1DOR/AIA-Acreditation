# Provision secrets externally. Blank values are deliberate; this file cannot start production.
DEPLOYMENT_ENV=production
NODE_ENV=production
AIA_SYNTHETIC_DATA=false
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
REDIS_URL=
APP_ORIGIN=
AUTH_ADDITIONAL_ORIGINS=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
AUTH_EMAIL_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_FINGERPRINT_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PHOTOS_BUCKET=
MINIO_REGION=
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional email monitoring; populate only in the appropriate private service file.
# RESEND_WEBHOOK_SECRET=  # web.env only, from the new Resend webhook endpoint
# RESEND_MONITOR_FROM_DOMAINS=notify.joinaia.pt
# RESEND_MONITOR_API_KEY= # operator/tools only; List Sent Emails permission
# EMAIL_MONITOR_ERASE_BEFORE= # approved cutoff for unlinked provider metadata
# EMAIL_MONITOR_POLICY_REFERENCE=
AIA_PROXY_SECRET=
# Set each attestation only after the actual control has been reviewed and tested.
CLERK_PRODUCTION_REVIEWED=false
SMTP_SENDER_VERIFIED=false
MINIO_PRIVATE_BUCKET_VERIFIED=false
MINIO_SCOPED_CREDENTIAL_VERIFIED=false
PRIVATE_INGRESS_VERIFIED=false
SECRET_CUSTODY_VERIFIED=false
AIA_PRIVACY_CONFIGURATION_APPROVED=false
BACKUP_CONFIGURATION_APPROVED=false
BACKUP_MAX_AGE_HOURS=
QUEUE_MAX_AGE_MINUTES=
REQUEST_ERROR_ALERT_THRESHOLD=
# AIA-approved global authentication-metadata cutoff; no legal period is supplied.
AUTH_METADATA_ERASE_BEFORE=
AUTH_METADATA_POLICY_REFERENCE=
# Keep these exclusively in the privileged worker/operator environment, never the web environment.
PRIVACY_DATABASE_URL=
BACKUP_DATABASE_URL=
BACKUP_DESTINATION=
BACKUP_PRIVATE_WORK_DIRECTORY=
BACKUP_ENCRYPTION_KEY_FILE=
RECOVERY_CUSTODY_KEY_FILE=
BACKUP_APPROVED_EXPIRY=
# Scheduled runs may instead use an explicitly approved duration; neither has a default.
BACKUP_RETENTION_HOURS=
BACKUP_POLICY_REFERENCE=
MONITOR_WEB_ORIGIN=
MONITOR_WORKER_ORIGIN=
MONITOR_POSTGRES_DATA_PATH=
MONITOR_MINIO_DATA_PATH=
MONITOR_TLS_ORIGIN=
MONITOR_TLS_MIN_VALID_DAYS=
CONTAINER_RESTART_ALERT_THRESHOLD=
