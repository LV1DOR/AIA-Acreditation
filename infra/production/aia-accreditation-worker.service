[Unit]
Description=AIA accreditation durable worker
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=aia-worker
Group=aia-worker
WorkingDirectory=/srv/aia-accreditation/current/apps/worker
EnvironmentFile=/etc/aia-accreditation/worker.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=50
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
