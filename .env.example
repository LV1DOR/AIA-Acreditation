# Local development only. Never reuse these credentials outside the isolated local stack.
DATABASE_URL=postgresql://acreditacao_local:local_only_password@127.0.0.1:16432/aia_acreditacao_local
TEST_DATABASE_URL=postgresql://acreditacao_local:local_only_password@127.0.0.1:16432/aia_acreditacao_test
REDIS_URL=redis://127.0.0.1:16379
WORKER_HEALTH_PORT=3102
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_FROM=acreditacao@example.invalid
# SMTP_USER=
# SMTP_PASSWORD=
# Resend is the future provider after domain purchase/verification; not Postmark.
# Optional monitoring only. These never select or reconfigure the sending provider.
# RESEND_WEBHOOK_SECRET=  # web process only; endpoint signing secret from Resend
# RESEND_MONITOR_FROM_DOMAINS=notify.joinaia.pt # exact sender domains, comma separated
# RESEND_MONITOR_API_KEY= # operator reconciliation only; never needed by web/worker
# EMAIL_MONITOR_ERASE_BEFORE= # approved ISO cutoff for unlinked provider metadata
# EMAIL_MONITOR_POLICY_REFERENCE= # required with cutoff; no guessed retention period
APP_ORIGIN=http://127.0.0.1:3100
# Optional private VPN access for service:dev (HTTPS on port 8443 only).
# LOCAL_DEV_TAILSCALE_ORIGIN=https://your-pc.your-tailnet.ts.net:8443
# When enabled, APP_ORIGIN may use that exact origin; allow loopback browsers via
# AUTH_ADDITIONAL_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Optional comma-separated HTTPS origins for explicitly trusted development tunnels.
# AUTH_ADDITIONAL_ORIGINS=https://your-current-tunnel.example
# Add all four to enable Clerk. Keep the secret key and encryption key server-only.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=
# AUTH_EMAIL_ENCRYPTION_KEY=
# Generate AUTH_EMAIL_ENCRYPTION_KEY as 32 cryptographically random bytes encoded as hex.
# Configure Clerk invite-only access and SMTP webhook delivery; see docs/AUTH-SETUP.md.

# Local private object storage and sensitive document protection.
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=acreditacao_minio
MINIO_SECRET_KEY=local_minio_password_only
MINIO_PHOTOS_BUCKET=aia-acreditacao-photos
MINIO_REGION=us-east-1
# Optional malware scan. Set when the ClamAV service is enabled.
# CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
# Generate two different 32-byte hex keys. Never reuse the email-encryption key.
# DOCUMENT_ENCRYPTION_KEY=
# DOCUMENT_FINGERPRINT_KEY=
# Only set behind a private ingress which overwrites x-aia-proxy-secret and x-aia-client-ip.
# AIA_PROXY_SECRET=<at least 32 random characters, same protected secret at ingress>

# Explicit synthetic-only local workflow. NODE_ENV is not deployment intent.
DEPLOYMENT_ENV=local
AIA_SYNTHETIC_DATA=true
# Production requires the separately reviewed settings in infra/production/environment.example.
# Destructive automatic retention is disabled; ADMIN approval and dedicated executor are required.
# PRIVACY_DATABASE_URL=
# BACKUP_MAX_AGE_HOURS=  # approved operational alert threshold
# QUEUE_MAX_AGE_MINUTES= # approved operational alert threshold
