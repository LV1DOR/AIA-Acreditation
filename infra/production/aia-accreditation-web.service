[Unit]
Description=AIA accreditation web
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=aia-web
Group=aia-web
WorkingDirectory=/srv/aia-accreditation/current/apps/web
EnvironmentFile=/etc/aia-accreditation/web.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
